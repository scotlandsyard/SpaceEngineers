<?xml version="1.0"?>
<!--
  Three bigger oxygen bottles and three bigger hydrogen bottles next to the vanilla ones
  (oxygen 40 L, hydrogen 400 L). The vanilla bottles are not changed.

  These are the defaults. A server can enable or disable each bottle and change its capacity,
  mass, build time and recipe in the world's config file (see README); the script applies it
  on load. Keep these values and TierConfig.CreateDefault() in Config.cs the same.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <PhysicalItems>

        <PhysicalItem xsi:type="MyObjectBuilder_OxygenContainerDefinition">
            <Id>
                <TypeId>OxygenContainerObject</TypeId>
                <SubtypeId>OxygenBottleTier2</SubtypeId>
            </Id>
            <DisplayName>Enhanced Oxygen Bottle</DisplayName>
            <Icon>Textures\GUI\Icons\component\OxygenBottleComponent.dds</Icon>
            <Icon>Textures\GUI\Icons\BottleTiers\Tier2.png</Icon>
            <Size>
                <X>0.8</X>
                <Y>0.24</Y>
                <Z>0.08</Z>
            </Size>
            <Mass>35</Mass>
            <Volume>120</Volume>
            <Model>Models\Components\OxygenTankItem.mwm</Model>
            <PhysicalMaterial>Metal</PhysicalMaterial>
            <StoredGasId>
                <TypeId>GasProperties</TypeId>
                <SubtypeId>Oxygen</SubtypeId>
            </StoredGasId>
            <Capacity>60</Capacity>
            <ExtraInventoryTooltipLine>Capacity: 60 L of oxygen</ExtraInventoryTooltipLine>
            <MinimumOfferAmount>5</MinimumOfferAmount>
            <MaximumOfferAmount>10</MaximumOfferAmount>
            <MinimumOrderAmount>20</MinimumOrderAmount>
            <MaximumOrderAmount>50</MaximumOrderAmount>
            <DepositAllEnabled>false</DepositAllEnabled>
            <CanPlayerOrder>true</CanPlayerOrder>
            <CanPlayerOffer>true</CanPlayerOffer>
            <MinimumAcquisitionAmount>10</MinimumAcquisitionAmount>
            <MaximumAcquisitionAmount>30</MaximumAcquisitionAmount>
        </PhysicalItem>

        <PhysicalItem xsi:type="MyObjectBuilder_OxygenContainerDefinition">
            <Id>
                <TypeId>OxygenContainerObject</TypeId>
                <SubtypeId>OxygenBottleTier3</SubtypeId>
            </Id>
            <DisplayName>Proficient Oxygen Bottle</DisplayName>
            <Icon>Textures\GUI\Icons\component\OxygenBottleComponent.dds</Icon>
            <Icon>Textures\GUI\Icons\BottleTiers\Tier3.png</Icon>
            <Size>
                <X>0.8</X>
                <Y>0.24</Y>
                <Z>0.08</Z>
            </Size>
            <Mass>50</Mass>
            <Volume>120</Volume>
            <Model>Models\Components\OxygenTankItem.mwm</Model>
            <PhysicalMaterial>Metal</PhysicalMaterial>
            <StoredGasId>
                <TypeId>GasProperties</TypeId>
                <SubtypeId>Oxygen</SubtypeId>
            </StoredGasId>
            <Capacity>100</Capacity>
            <ExtraInventoryTooltipLine>Capacity: 100 L of oxygen</ExtraInventoryTooltipLine>
            <MinimumOfferAmount>2</MinimumOfferAmount>
            <MaximumOfferAmount>5</MaximumOfferAmount>
            <MinimumOrderAmount>10</MinimumOrderAmount>
            <MaximumOrderAmount>30</MaximumOrderAmount>
            <DepositAllEnabled>false</DepositAllEnabled>
            <CanPlayerOrder>true</CanPlayerOrder>
            <CanPlayerOffer>true</CanPlayerOffer>
            <MinimumAcquisitionAmount>10</MinimumAcquisitionAmount>
            <MaximumAcquisitionAmount>20</MaximumAcquisitionAmount>
        </PhysicalItem>

        <PhysicalItem xsi:type="MyObjectBuilder_OxygenContainerDefinition">
            <Id>
                <TypeId>OxygenContainerObject</TypeId>
                <SubtypeId>OxygenBottleTier4</SubtypeId>
            </Id>
