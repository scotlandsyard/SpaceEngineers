            <Icon>Textures\GUI\Icons\component\OxygenBottleComponent.dds</Icon>
            <Icon>Textures\GUI\Icons\TieredGasBottles\Tier4.png</Icon>
            <Prerequisites>
                <Item Amount="400" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="80" TypeId="Ingot" SubtypeId="Silicon" />
                <Item Amount="100" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="22.5" TypeId="Ingot" SubtypeId="Cobalt" />
                <Item Amount="12.5" TypeId="Ingot" SubtypeId="Silver" />
                <Item Amount="2.5" TypeId="Ingot" SubtypeId="Magnesium" />
                <Item Amount="5" TypeId="Ingot" SubtypeId="Gold" />
                <Item Amount="2" TypeId="Ingot" SubtypeId="Platinum" />
            </Prerequisites>
            <Result Amount="1" TypeId="OxygenContainerObject" SubtypeId="OxygenBottleTier4" />
            <BaseProductionTimeInSeconds>60</BaseProductionTimeInSeconds>
            <IsPrimary>true</IsPrimary>
        </Blueprint>

