<?xml version="1.0"?>
<!--
  Assembly recipes (defaults; a server can change them in the config file, see README) and refill
  recipes. The refill recipes are what lets H2/O2 generators and gas tanks accept and fill the
  bottles. They copy the vanilla OxygenBottlesRefill / HydrogenBottlesRefill, gravel result included.
-->
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <Blueprints>

        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>Position0011_OxygenBottleTier2</SubtypeId>
            </Id>
            <DisplayName>Enhanced Oxygen Bottle</DisplayName>
            <Icon>Textures\GUI\Icons\component\OxygenBottleComponent.dds</Icon>
            <Icon>Textures\GUI\Icons\TieredGasBottles\Tier2.png</Icon>
            <Prerequisites>
                <Item Amount="105" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="25" TypeId="Ingot" SubtypeId="Silicon" />
                <Item Amount="40" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="5" TypeId="Ingot" SubtypeId="Cobalt" />
            </Prerequisites>
            <Result Amount="1" TypeId="OxygenContainerObject" SubtypeId="OxygenBottleTier2" />
            <BaseProductionTimeInSeconds>15</BaseProductionTimeInSeconds>
            <IsPrimary>true</IsPrimary>
        </Blueprint>

        <Blueprint>
            <Id>
                <TypeId>BlueprintDefinition</TypeId>
                <SubtypeId>Position0012_OxygenBottleTier3</SubtypeId>
            </Id>
            <DisplayName>Proficient Oxygen Bottle</DisplayName>
            <Icon>Textures\GUI\Icons\component\OxygenBottleComponent.dds</Icon>
            <Icon>Textures\GUI\Icons\TieredGasBottles\Tier3.png</Icon>
            <Prerequisites>
                <Item Amount="240" TypeId="Ingot" SubtypeId="Iron" />
                <Item Amount="40" TypeId="Ingot" SubtypeId="Silicon" />
                <Item Amount="65" TypeId="Ingot" SubtypeId="Nickel" />
                <Item Amount="15" TypeId="Ingot" SubtypeId="Cobalt" />
                <Item Amount="5" TypeId="Ingot" SubtypeId="Silver" />
                <Item Amount="0.5" TypeId="Ingot" SubtypeId="Magnesium" />
            </Prerequisites>
            <Result Amount="1" TypeId="OxygenContainerObject" SubtypeId="OxygenBottleTier3" />
            <BaseProductionTimeInSeconds>30</BaseProductionTimeInSeconds>
            <IsPrimary>true</IsPrimary>
        </Blueprint>

