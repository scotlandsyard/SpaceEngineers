<Project>
  <!--
    Text files a plugin reads at runtime (its chat lines), compiled in as C# string constants.
    Pulsar's PluginHub builds plugins from source and compiles only .cs files, so an embedded resource would be
    missing there. Each <EmbeddedText Include="X.txt" /> becomes X.txt.cs next to it, holding the constant
    TimShared.EmbeddedText.X. The .cs file is rewritten on every build and committed with the source:
    edit the .txt file, never the .cs one.

    Use: list the files in an <EmbeddedText> item, then import this file at the end of the csproj:
      <Import Project="../../../Shared/EmbedText.targets" />
  -->
  <ItemGroup>
    <!-- Added back by the target below, after it has been regenerated. -->
    <Compile Remove="@(EmbeddedText->'%(Identity).cs')" />
  </ItemGroup>

  <UsingTask TaskName="TimEmbedText" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
foreach (var file in Files)
{
    string source = file.GetMetadata("FullPath");
    string name = Path.GetFileNameWithoutExtension(source);
    string text = File.ReadAllText(source).Replace("\r\n", "\n").Replace("\"", "\"\"");
    string code =
        "// <auto-generated>\n" +
        "// Made from " + Path.GetFileName(source) + " by Shared/EmbedText.targets on every build. Edit the .txt file, not this one.\n" +
        "// </auto-generated>\n" +
        "namespace TimShared;\n\n" +
        "internal static partial class EmbeddedText\n{\n" +
        "\tpublic const string " + name + " = @\"" + text + "\";\n" +
        "}\n";
    string target = source + ".cs";
    if (!File.Exists(target) || File.ReadAllText(target) != code)
    {
        File.WriteAllText(target, code, new UTF8Encoding(false));
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="TimEmbedText" BeforeTargets="CoreCompile" Condition="'@(EmbeddedText)' != ''">
    <TimEmbedText Files="@(EmbeddedText)" />
    <ItemGroup>
      <Compile Include="@(EmbeddedText->'%(Identity).cs')" />
    </ItemGroup>
  </Target>
</Project>
