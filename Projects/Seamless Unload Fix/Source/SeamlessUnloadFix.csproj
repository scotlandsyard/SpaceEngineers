<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SeamlessUnloadFix</AssemblyName>
    <RootNamespace>SeamlessUnloadFix</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <!-- The DLL may be shared: build no debug-symbol file, so the DLL doesn't record a path to one, and map
         source paths to "." so no folder from this computer ends up inside the DLL. -->
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Path to the Space Engineers Bin64 folder. Change it here if the game is installed
    somewhere else, or pass it on the command line:
      dotnet build -c Release -p:Bin64="D:\SteamLibrary\steamapps\common\SpaceEngineers\Bin64"
  -->
  <PropertyGroup>
    <Bin64 Condition="'$(Bin64)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</Bin64>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the project build against .NET Framework 4.8.1 without a separate targeting pack install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Pulsar loads its own 0Harmony.dll (2.4.2); compile against it, never ship a copy. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies: referenced from the install, never copied to the output. -->
  <ItemGroup>
    <Reference Include="Sandbox.Common"><HintPath>$(Bin64)\Sandbox.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(Bin64)\Sandbox.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage"><HintPath>$(Bin64)\VRage.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(Bin64)\VRage.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(Bin64)\VRage.Library.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
</Project>
